# ---- ตั้งค่าแอป (แก้แล้วรัน start.bat ใหม่) ----

# ว่าง = build image เองในเครื่อง (ครั้งแรกใช้ 1-3 นาที)
# ใส่ชื่อ image จาก GitHub = ดาวน์โหลด image สำเร็จรูปที่ CI สร้างไว้ (เร็วกว่า)
# เช่น APP_IMAGE=ghcr.io/your-github-name/income-expense-app:latest
APP_IMAGE=

# พอร์ตที่เปิดในเบราว์เซอร์ เช่น 8080 -> http://localhost:8080
APP_PORT=8080

# 127.0.0.1 = ใช้ได้เฉพาะเครื่องนี้ (ค่าเริ่มต้น ปลอดภัยที่สุด)
# 0.0.0.0   = ให้มือถือ/เครื่องอื่นใน Wi-Fi เดียวกันเข้าได้ (ควรตั้งรหัสผ่านด้านล่างด้วย)
BIND_ADDRESS=127.0.0.1

# ชื่อเครื่องเพิ่มเติมที่ใช้เปิดแอป คั่นด้วยจุลภาค เช่น mypc.local (localhost และเลข IP ใช้ได้อยู่แล้ว)
# ชื่ออื่นที่ไม่อยู่ในรายการจะถูกปฏิเสธ เพื่อกันการโจมตีแบบ DNS rebinding
ALLOWED_HOSTS=

# ตั้งรหัสผ่านเพื่อล็อกแอป (เว้นว่าง = ไม่ใช้รหัสผ่าน) ใช้ตัวอักษรภาษาอังกฤษ/ตัวเลข
APP_USER=admin
APP_PASSWORD=
